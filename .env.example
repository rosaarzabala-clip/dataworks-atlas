# Copy to .env and fill in. Never commit .env.

# Alibaba Cloud / Apsara Stack credentials. Use a read-only RAM user.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# DataWorks (Apsara Stack). Requires the Hillstone VPN.
DATAWORKS_ENDPOINT=
DATAWORKS_REGION=
DATAWORKS_PROJECT_ID=
DATAWORKS_VERSION=2020-05-18

# Neo4j
NEO4J_PASSWORD=
NEO4J_HTTP=http://localhost:7474/db/neo4j/tx/commit
